prog = [ expr { ";" expr } ] ;

expr  = sum     [ "=" expr ] ;
sum   = prod    { ("+" | "-") prod  } ;
prod  = unary   { ("*" | "/") unary } ;
unary = ("+" | "-") unary | postfix [ "^" unary ] ;

postfix = primary { "(" [ args ] ")" } ;
args    = expr { "," expr } ;

primary =
    number
  | ident
  | "(" expr ")"

ident   = ( letter | "_" ) { letter | digit | "_" } ;
number  = digit { digit } ;
letter  = "a".."z" | "A".."Z" ;
digit   = "0".."9" ;